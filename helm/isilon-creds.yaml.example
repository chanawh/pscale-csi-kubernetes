# Copy to isilon-creds.yaml and fill in your OneFS values.
# NEVER commit the filled-in file. It holds the root password.
# Create the secret with:
#   kubectl create secret generic isilon-creds -n csi-isilon \
#     --from-file=config=isilon-creds.yaml
# Format is the driver's own config file, not a generic secret.
apiVersion: v1
kind: Secret
metadata:
  name: isilon-creds
  namespace: csi-isilon
stringData:
  config: |
    isilonClusters:
      - clusterName: nas2aws-onefs
        endpoint: "192.168.1.50"
        endpointPort: 8080
        isDefault: true
        user: root
        password: "CHANGE-ME"
        skipCertificateValidation: true
        isiPath: /ifs/data/csi
        isiAccessZone: System
